---
import Base from "../layouts/Base.astro";
import { formatDate, isoDate, postAccent, posts, projects, readingMinutes, site, summary } from "../site.ts";

const entries = await Promise.all(
  (await posts()).map(async (post) => ({ post, accent: await postAccent(post) })),
);
// posts() is newest first, so years and the posts within them come out newest first too.
const years = Map.groupBy(entries, ({ post }) => post.data.date.getUTCFullYear());
---
<Base path="/" home>
  <section class="intro" aria-label="About">
    <p class="lead">I build software and look after the machines it runs on. This is where I write about it.</p>
    <p>Lately that is mostly home infrastructure: a Raspberry Pi running the house and a network defined in Pulumi.</p>
    <ul class="cluster intro-links">
      <li><a class="action" href="https://resume.dougborg.org/"><span class="nerd-icon" aria-hidden="true">&#xf0f6;</span>Résumé</a></li>
      <li><a class="action" href="https://github.com/dougborg"><span class="nerd-icon" aria-hidden="true">&#xf09b;</span>GitHub</a></li>
      <li><a class="action" href={`mailto:${site.email}`}><span class="nerd-icon" aria-hidden="true">&#xf0e0;</span>Email</a></li>
    </ul>
  </section>

  <section class="content-section" aria-labelledby="posts">
    <h2 class="section-title" id="posts"><span class="nerd-icon section-icon" aria-hidden="true">&gt;_</span>Posts</h2>
    {[...years].map(([year, group]) => (
      <section class="post-year" aria-label={`${year}`}>
        <p class="post-year-label" aria-hidden="true">{year}</p>
        <ol class="timeline-list">
          {group.map(({ post, accent }) => (
            <li data-accent={accent}>
              <article>
                <h3 class="entry-title"><a href={`/posts/${post.id}/`}>{post.data.title}</a></h3>
                <p class="meta meta-row"><time datetime={isoDate(post.data.date)}>{formatDate(post.data.date)}</time><span>{readingMinutes(post)} min read</span></p>
                <p>{summary(post)}</p>
              </article>
            </li>
          ))}
        </ol>
      </section>
    ))}
  </section>

  <section class="content-section" aria-labelledby="projects">
    <h2 class="section-title" id="projects"><span class="nerd-icon section-icon" aria-hidden="true">&#xf121;</span>Projects</h2>
    <ul class="card-grid projects">
      {projects.map((project) => (
        <li class="card" data-accent={project.accent}>
          <h3 class="entry-title"><a href={project.href}>{project.name}</a></h3>
          <p>{project.text}</p>
        </li>
      ))}
    </ul>
  </section>
</Base>
