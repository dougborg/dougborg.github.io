---
import { render } from "astro:content";
import Base from "../../layouts/Base.astro";
import { formatDate, isoDate, posts } from "../../site.ts";

export async function getStaticPaths() {
  return (await posts()).map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---
<Base path={`/posts/${post.id}/`} title={post.data.title} description={post.data.description} published={post.data.date}>
  <article>
    <header class="article-header">
      <h1>{post.data.title}</h1>
      <p class="meta"><time datetime={isoDate(post.data.date)}>{formatDate(post.data.date)}</time></p>
    </header>
    <div class="prose">
      <Content />
    </div>
  </article>
</Base>
